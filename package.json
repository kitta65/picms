{
	"name": "picms",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"workspaces": {
		"packages": [
			"packages/*"
		],
		"catalog": {
			"@types/bun": "latest",
			"hono": "^4.13.7",
			"zod": "^4.5.4",
			"typescript": "^7.0.2"
		}
	},
	"scripts": {
		"setup": "bun install && bun run --filter '*' setup",
		"dev": "bun run --filter '*' --parallel dev",
		"start": "./packages/main/dist/picms &",
		"stop": "pkill -x picms",
		"build": "bun run --filter '*' build",
		"lint": "knip && biome check && bun run --filter '*' --parallel lint",
		"fix": "knip --fix && biome check --write",
		"fix:unsafe": "knip --fix && biome check --write --unsafe",
		"prepare": "bunx --bun husky",
		"test": "bun run --filter '*' --parallel test",
		"e2e": "bun run --filter 'picms-e2e' e2e"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.12",
		"@types/bun": "catalog:",
		"husky": "^9.1.7",
		"knip": "^6.34.0",
		"typescript": "catalog:"
	}
}
