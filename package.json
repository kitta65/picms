{
	"name": "picms",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"setup": "bun install",
		"dev": "bun run --filter '*' --parallel dev",
		"start": "./packages/main/dist/picms",
		"build": "bun run --filter '*' build",
		"lint": "knip && biome check",
		"fix": "knip --fix && biome check --write",
		"fix:unsafe": "knip --fix && biome check --write --unsafe",
		"prepare": "husky"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.14",
		"@types/node": "^25.6.0",
		"husky": "^9.1.7",
		"knip": "^6.11.0",
		"typescript": "^6.0.3"
	}
}
