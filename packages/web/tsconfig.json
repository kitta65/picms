{
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		// Environment setup & latest features
		"lib": ["ESNext", "DOM"],
		"target": "ESNext",
		"module": "Preserve",
		"moduleDetection": "force",
		"jsx": "react-jsx",
		"types": ["bun", "react"],

		// Bundler mode
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"noEmit": true,

		"paths": {
			"@/*": ["./src/*"]
		}
	},

	"exclude": ["dist", "node_modules"]
}
