// https://containers.dev/implementors/json_reference/
{
	"name": "${localWorkspaceFolderBasename}",
	"dockerComposeFile": "./docker-compose.yml",
	"service": "picms",
	"workspaceFolder": "/workspaces/picms",
	"shutdownAction": "stopCompose",
	"containerEnv": {
		// https://code.claude.com/docs/en/env-vars
		"CLAUDE_CONFIG_DIR": "${containerWorkspaceFolder}/.cache/claude-config",
		"BUN_INSTALL_CACHE_DIR": "${containerWorkspaceFolder}/.cache/bun",
		// https://cli.github.com/manual/gh_help_environment
		"GH_CONFIG_DIR": "${containerWorkspaceFolder}/.cache/gh"
	},
	"forwardPorts": ["dbgate:3000"],
	"features": {
		"ghcr.io/devcontainers/features/docker-outside-of-docker:1": {},
		"ghcr.io/devcontainers/features/github-cli:1": {}
	},
	"postCreateCommand": {
		"bun": "bun run setup && bun run build",
		"env": "echo export BUN_CHROME_PATH=$(find ~/.cache/ms-playwright -maxdepth 3 -type f -name 'chrome-headless-shell') >> ~/.bashrc"
	},
	"customizations": {
		"vscode": {
			// publisher.extension@version
			"extensions": [
				"anthropic.claude-code@2.1.246",
				"biomejs.biome@3.7.1",
				"bradlc.vscode-tailwindcss@0.16.0",
				"GitHub.vscode-github-actions@0.32.3",
				"oven.bun-vscode@0.0.32",
				"tamasfe.even-better-toml@0.21.2"
			],
			"settings": {
				// prevent pinned extensions from auto-updating
				"extensions.autoCheckUpdates": false,
				"extensions.autoUpdate": false,
				"editor.defaultFormatter": "biomejs.biome",
				// recommended by tailwind https://marketplace.visualstudio.com/items?itemName=bradlc.vscode-tailwindcss
				"editor.quickSuggestions": {
					"strings": "on"
				},
				"editor.tabSize": 2,
				"files.associations": {
					"*.css": "tailwindcss"
				},
				"json.schemaDownload.trustedDomains": {
					"https://ui.shadcn.com/": true,
					"https://unpkg.com": true
				},
				"tailwindCSS.classFunctions": ["cn"],
				"[dockerfile]": {
					"editor.tabSize": 4
				},
				"[toml]": {
					"editor.defaultFormatter": "tamasfe.even-better-toml"
				}
			}
		}
	}
}
