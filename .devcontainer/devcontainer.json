// https://containers.dev/implementors/json_reference/
{
	"name": "${localWorkspaceFolderBasename}",
	"build": {
		"dockerfile": "Dockerfile"
	},
	"containerEnv": {
		// https://code.claude.com/docs/en/env-vars
		"CLAUDE_CONFIG_DIR": "${containerWorkspaceFolder}/.claude-config",
		"BUN_INSTALL_CACHE_DIR": "${containerWorkspaceFolder}/.bun-cache"
	},
	"features": {
		"ghcr.io/devcontainers/features/github-cli:1": {}
	},
	"postCreateCommand": "bun run setup && bun run build",
	"customizations": {
		"vscode": {
			"extensions": [
				"anthropic.claude-code",
				"biomejs.biome",
				"bradlc.vscode-tailwindcss",
				"GitHub.vscode-github-actions",
				"oven.bun-vscode",
				"tamasfe.even-better-toml"
			],
			"settings": {
				"editor.defaultFormatter": "biomejs.biome",
				// recommended by tailwind https://marketplace.visualstudio.com/items?itemName=bradlc.vscode-tailwindcss
				"editor.quickSuggestions": {
					"strings": "on"
				},
				"editor.tabSize": 2,
				"files.associations": {
					"*.css": "tailwindcss"
				},
				"json.schemaDownload.trustedDomains": {
					"https://ui.shadcn.com/": true,
					"https://unpkg.com": true
				},
				"[dockerfile]": {
					"editor.tabSize": 4
				}
			}
		}
	}
}
